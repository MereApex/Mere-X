{
  "name": "mere-x-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c white,gray \"vite --host 127.0.0.1\" \"node --watch server/index.mjs\"",
    "dev:web": "vite",
    "api": "node server/index.mjs",
    "db:migrate": "node scripts/mysql-migrate.mjs",
    "db:import:sqlite": "node scripts/mysql-import-sqlite.mjs",
    "build": "tsc -b && vite build",
    "test:database": "node scripts/mysql-smoke.mjs",
    "test:platform": "node scripts/platform-smoke.mjs",
    "test:ui": "node scripts/ui-all-smoke.mjs",
    "test:landing": "node scripts/ui-landing-smoke.mjs",
    "test:chat-ui": "node scripts/ui-chat-design-smoke.mjs",
    "test:sidebar-ui": "node scripts/ui-sidebar-design-smoke.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.5",
    "dejavu-fonts-ttf": "^2.37.3",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "latest",
    "mammoth": "^1.12.1",
    "mysql2": "^3.23.3",
    "officegen": "^0.6.5",
    "pdfkit": "^0.19.1",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
