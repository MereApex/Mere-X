{
  "name": "Mere X",
  "short_name": "Mere X",
  "description": "Chat, create, research, and build with Mere X.",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f7f4ee",
