  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/app/icons/mere-x-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app/icons/mere-x-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app/icons/mere-x-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New chat", "short_name": "Chat", "url": "/app/", "icons": [{ "src": "/app/icons/mere-x-192.png", "sizes": "192x192" }] }
  ]
}
