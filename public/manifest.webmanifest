{
  "name": "Mere Studio",
  "short_name": "Mere Studio",
  "description": "The coding agent that works on your project in the browser.",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/app/icons/mere-x-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/app/icons/mere-x-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/app/icons/mere-x-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New thread", "short_name": "Thread", "url": "/app/", "icons": [{ "src": "/app/icons/mere-x-192.png", "sizes": "192x192" }] }
  ]
}
