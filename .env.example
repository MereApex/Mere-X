# Server-only secret. Never expose this value in VITE_* variables.
MERE_API_KEY=

# Required persistent database. On Railway, reference the MySQL service's
# private MYSQL_URL variable; use a public proxy URL only for local development.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
MYSQL_POOL_SIZE=10
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Optional internal route overrides. Leave blank to use Mere X defaults.
MERE_PRIMARY_MODEL=
MERE_IMAGE_MODEL=
MERE_LIVE_MODEL=
MERE_VIDEO_MODEL=

# Production billing handoff and signed event verification.
MERE_BILLING_PLUS_URL=
MERE_BILLING_PRO_URL=
MERE_BILLING_TEAM_URL=
MERE_BILLING_WEBHOOK_SECRET=

# Railway provides PORT automatically. MERE_PORT is the local fallback.
MERE_PORT=8787
