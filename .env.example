# Server-only secret. Never expose this value in VITE_* variables.
MERE_API_KEY=

# Required persistent database. On Railway, reference the MySQL service's
# private MYSQL_URL variable; use a public proxy URL only for local development.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
MYSQL_POOL_SIZE=10
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Optional internal route overrides. Leave blank to use Mere X defaults.
MERE_PRIMARY_MODEL=
MERE_IMAGE_MODEL=
MERE_LIVE_MODEL=
MERE_VIDEO_MODEL=

# Secure recurring billing. The client ID is browser-safe; the secret must stay
# server-only. Use sandbox until the complete checkout and webhook flow is verified.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
PUBLIC_APP_URL=https://YOUR_PUBLIC_DOMAIN
PAYPAL_WEBHOOK_ID=

# Optional overrides. Mere X creates the product and six monthly/annual plans
# automatically when these IDs are blank.
PAYPAL_PRODUCT_ID=
PAYPAL_PLUS_MONTHLY_PLAN_ID=
PAYPAL_PLUS_ANNUAL_PLAN_ID=
PAYPAL_PRO_MONTHLY_PLAN_ID=
PAYPAL_PRO_ANNUAL_PLAN_ID=
PAYPAL_TEAM_MONTHLY_PLAN_ID=
PAYPAL_TEAM_ANNUAL_PLAN_ID=

# Railway provides PORT automatically. MERE_PORT is the local fallback.
MERE_PORT=8787
