# Server-only secret. Never expose this value in VITE_* variables.
MERE_API_KEY=

# Required persistent database. On Railway, reference the MySQL service's
# private MYSQL_URL variable; use a public proxy URL only for local development.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
MYSQL_POOL_SIZE=10
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Internal capability routes. Keep these server-side and review preview model IDs
# before each production release.
MERE_PRIMARY_MODEL=gemini-3.7-flash
MERE_IMAGE_MODEL=gemini-3-pro-image
MERE_LIVE_MODEL=gemini-3.1-flash-live-preview
MERE_VIDEO_MODEL=veo-3.1-generate-preview
MERE_COMPUTER_MODEL=gemini-3.6-flash

# Account verification and Google Identity Services. GOOGLE_CLIENT_ID is the
# Web application OAuth client ID; no Google client secret is needed here.
GOOGLE_CLIENT_ID=
AUTH_CODE_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
AUTH_PREVIEW_CODES=false
RESEND_API_KEY=
RESEND_FROM=Mere X <account@YOUR_VERIFIED_DOMAIN>

# Secure recurring billing. The client ID is browser-safe; the secret must stay
# server-only. Use sandbox until the complete checkout and webhook flow is verified.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CURRENCY=USD
PUBLIC_APP_URL=https://YOUR_PUBLIC_DOMAIN
PAYPAL_WEBHOOK_ID=

# Optional overrides. Mere X creates the product and six monthly/annual plans
# automatically when these IDs are blank.
PAYPAL_PRODUCT_ID=
PAYPAL_PLUS_MONTHLY_PLAN_ID=
PAYPAL_PLUS_ANNUAL_PLAN_ID=
PAYPAL_PRO_MONTHLY_PLAN_ID=
PAYPAL_PRO_ANNUAL_PLAN_ID=
PAYPAL_TEAM_MONTHLY_PLAN_ID=
PAYPAL_TEAM_ANNUAL_PLAN_ID=

# Railway provides PORT automatically. MERE_PORT is the local fallback.
MERE_PORT=8787
